# Copy to .env.local and fill in. Never commit real values.
# .env.local is DEVELOPMENT (dev Supabase project, dev Clerk app). Production values live in an
# untracked .env.production.local and in Vercel; see docs/releasing.md.
# `clerk env pull` writes the Clerk keys for the linked app.

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Signing secret of the Clerk webhook endpoint that points at /api/webhooks/clerk.
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Supabase (Project Settings -> API / Database). Use the DEVELOPMENT project.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or legacy anon key. Safe in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_.
# Secret key (sb_secret_...) or legacy service_role key. Used by the seed/owner scripts
# and, in the app, only by src/lib/supabase/admin.ts (Clerk -> profiles sync).
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string for `npm run db:push` / `db:types` (percent-encode the password).
SUPABASE_DB_URL=
# Personal access token (supabase.com/dashboard/account/tokens) for `npm run db:types`.
# Optional if you ran `npx supabase login` once.
SUPABASE_ACCESS_TOKEN=
# Must be `development` for `npm run seed:load` / `seed:purge` to run.
GORETO_DATA_ENV=

# App
# Public origin, e.g. https://goreto.store. Staff invitation links land on <origin>/sign-up.
# Required in production (invites fail without it); in development the request origin is used if unset.
NEXT_PUBLIC_SITE_URL=

# Map tiles for checkout "Use Current Location" and the tracking page (optional).
# Defaults to OpenStreetMap's public tiles, which are for light use only
# (https://operations.osmfoundation.org/policies/tiles/). For production traffic,
# point this at a tile provider and set its attribution (HTML allowed).
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=

# Daraz Express (DEX) courier API: docs/couriers/daraz.md. Server-only; never NEXT_PUBLIC_.
# From the Daraz Open Platform App Console (open.daraz.com). The integration is off until both are set.
DARAZ_APP_KEY=
DARAZ_APP_SECRET=
# Optional. Defaults to https://api.daraz.com.np/rest. In development only, http://localhost:4010
# points at the mock gateway (`npm run daraz:mock`).
DARAZ_API_URL=
# Bearer token for /api/cron/courier-sync (Vercel Cron sends it automatically; at least 16 characters).
CRON_SECRET=
