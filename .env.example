# Copy to .env.local and fill in. Never commit real values.
# `clerk env pull` writes the Clerk keys for the linked app.

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Signing secret of the Clerk webhook endpoint that points at /api/webhooks/clerk.
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Supabase (Project Settings -> API / Database). Use the DEVELOPMENT project.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or legacy anon key. Safe in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_.
# Secret key (sb_secret_...) or legacy service_role key. Used by the seed/owner scripts
# and, in the app, only by src/lib/supabase/admin.ts (Clerk -> profiles sync).
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string for `npm run db:push` / `db:types` (percent-encode the password).
SUPABASE_DB_URL=
# Personal access token (supabase.com/dashboard/account/tokens) for `npm run db:types`.
# Optional if you ran `npx supabase login` once.
SUPABASE_ACCESS_TOKEN=
# Must be `development` for `npm run seed:load` / `seed:purge` to run.
GORETO_DATA_ENV=
