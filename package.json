{
  "name": "goreto",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:generate": "node scripts/seed/generate.ts",
    "test:db": "vitest run --config vitest.db.config.mts",
    "db:push": "node --env-file-if-exists=.env.local scripts/db/supabase.ts push",
    "db:types": "node --env-file-if-exists=.env.local scripts/db/supabase.ts types",
    "seed:load": "node --env-file-if-exists=.env.local scripts/seed/load.ts",
    "seed:purge": "node --env-file-if-exists=.env.local scripts/seed/purge.ts",
    "owner:bootstrap": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/auth/bootstrap-owner.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.5",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.9.1",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "2.117.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "libphonenumber-js": "^1.13.14",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.7.0",
    "topojson-client": "^3.1.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-server": "^3.0.4",
    "@types/topojson-simplify": "^3.0.3",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "jsdom": "^30.1.1",
    "osmtogeojson": "^3.0.0-beta.5",
    "supabase": "2.117.0",
    "tailwindcss": "^4",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
